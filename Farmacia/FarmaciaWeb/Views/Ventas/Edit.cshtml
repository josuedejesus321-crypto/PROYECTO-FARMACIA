@model LogicaCompartida.Entidades.Definir_Ventas.DetalleVenta
@{
    ViewData["Title"] = "Editar Ventas";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-action="Edit" method="post">
                        <input asp-for="IdDetalle" type="hidden" />
                        
                        <div class="mb-3">
                            <label class="form-label">ID Detalle ventas</label>
                            <input value="@Model.IdDetalle" class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdVenta" class="form-label">Id Detalle ventas *</label>
                            <input asp-for="IdVenta" class="form-control" placeholder="Ingrese el ID de la venta" required />
                            <span asp-validation-for="IdVenta" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdMedicamento" class="form-label">Id Medicamento *</label>
                            <input asp-for="IdMedicamento" class="form-control" placeholder="Ingrese el ID del medicamento" required />
                            <span asp-validation-for="IdMedicamento" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Cantidad" class="form-label">Cantidad *</label>
                            <input asp-for="Cantidad" class="form-control" placeholder="Ingrese la cantidad" required />
                            <span asp-validation-for="Cantidad" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="PrecioUnitario" class="form-label">Precio Unitario *</label>
                            <input asp-for="PrecioUnitario" class="form-control" placeholder="Ingrese el precio unitario" required />
                            <span asp-validation-for="PrecioUnitario" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save"></i> Actualizar Venta
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}