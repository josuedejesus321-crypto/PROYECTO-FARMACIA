@model LogicaCompartida.Entidades.Definir_Compras.Compras
@{
    ViewData["Title"] = "Editar Compra";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-action="Edit" method="post">
                        <input asp-for="IdCompra" type="hidden" />
                        
                        <div class="mb-3">
                            <label class="form-label">ID Cliente</label>
                            <input value="@Model.IdCompra" class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdProveedor" class="form-label">Id Proveedor *</label>
                            <input asp-for="IdProveedor" class="form-control" placeholder="Ingrese el ID completo" required />
                            <span asp-validation-for="IdProveedor" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FechaCompra" class="form-label">Fecha Compra *</label>
                            <input asp-for="FechaCompra" class="form-control" placeholder="Ingrese la fecha de la compra" required />
                            <span asp-validation-for="FechaCompra" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdMedicamento" class="form-label">Id Medicamento *</label>
                            <input asp-for="IdMedicamento" type="email" class="form-control" placeholder="Ingrese el ID completo" required />
                            <span asp-validation-for="IdMedicamento" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CantidadComprada" class="form-label">Cantidad Comprada *</label>
                            <textarea asp-for="CantidadComprada" class="form-control" rows="3" placeholder="Ingrese la cantidad comprada" required></textarea>
                            <span asp-validation-for="CantidadComprada" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PrecioUnidad" class="form-label">Precio por Unidad *</label>
                            <textarea asp-for="PrecioUnidad" class="form-control" rows="3" placeholder="Ingrese el precio por unidad" required></textarea>
                            <span asp-validation-for="PrecioUnidad" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdEmpleado" class="form-label">Id Empleado *</label>
                            <textarea asp-for="IdEmpleado" class="form-control" rows="3" placeholder="Ingrese Id Completo" required></textarea>
                            <span asp-validation-for="IdEmpleado" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save"></i> Actualizar Compra
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}