@model FarmaciaWeb.Models.DashboardViewModel
@{
    // Esta parte es código C# que define el título de la página
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">Resumen del Inventario</h1>
</div>

<div class="dashboard-container">

    <div class="card card-blue">
        <div class="card-header">
            <i class="fas fa-paw icon-bg"></i>
            <div class="card-info">
                <span class="label">TOTAL CLIENTES</span>
                <span class="value" id="totalCustomers">@Model.TotalCustomers</span> 
            </div>
        </div>
        <div class="card-footer">
            <a href="CLIENTES" class="details-link">
                <i class="fas fa-bars show-details-icon"></i> Show Details
            </a>
        </div>
    </div>

    <div class="card card-green">
        <div class="card-header">
            <i class="fas fa-pills icon-bg"></i>
            <div class="card-info">
                <span class="label">TOTAL MEDICAMENTOS</span>
                <span class="value" id="totalMedicine">@Model.TotalMedicine</span>
            </div>
        </div>
        <div class="card-footer">
            <a href="MEDICAMENTOS" class="details-link">
                <i class="fas fa-bars show-details-icon"></i> Show Details
            </a>
        </div>
    </div>

    <div class="card card-red">
        <div class="card-header">
            <i class="fas fa-vial icon-bg"></i>
            <div class="card-info">
                <span class="label">FUERA DE STOCK</span>
                <span class="value" id="outOfStock">@Model.OutOfStock</span>
            </div>
        </div>
        <div class="card-footer">
            <a href="MEDICAMENTOS" class="details-link">
                <i class="fas fa-bars show-details-icon"></i> Show Details
            </a>
        </div>
    </div>

    <div class="card card-orange">
        <div class="card-header">
            <i class="fas fa-truck icon-bg"></i> 
            <div class="card-info">
                <span class="label">TOTAL PROVEEDORES</span>
                <span class="value" id="totalSuppliers">@Model.TotalSuppliers</span>
            </div>
        </div>
        <div class="card-footer">
            <a href="PROVEEDORES" class="details-link">
                <i class="fas fa-bars show-details-icon"></i> Show Details
            </a>
        </div>
    </div>
</div>