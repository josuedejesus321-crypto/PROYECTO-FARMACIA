@model List<LogicaCompartida.Entidades.Definir_Historial_Ventas.Historial_Ventas>
@{
    ViewData["Title"] = "Historial de Ventas";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2>@ViewData["Title"]</h2>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

                <div class="col-md-6">
                <form method="get" action="@Url.Action("Search")" class="d-flex">
                    <input type="text" name="searchTerm" class="form-control me-2" placeholder="Buscar venta..." 
                            value="@ViewBag.SearchTerm">
                    <button type="submit" class="btn btn-outline-secondary">Buscar</button>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                        {
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary ms-2">Limpiar</a>
                        }
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID Historial venta</th>
                                        <th>ID Venta</th>
                                        <th>Id Empleado</th>
                                        <th>Fecha de Venta</th>
                                        <th>Cantidad Vendida</th>
                                        <th>ID Medicamento</th>
                                        <th>Precio Unitario</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var Historial_Ventas in Model)
                                    {
                                        <tr>
                                            <td>@Historial_Ventas.IdHistorialVenta</td>
                                            <td>@Historial_Ventas.IdVenta</td>
                                            <td>@Historial_Ventas.IdEmpleado</td>
                                            <td>@Historial_Ventas.FechaVenta</td>
                                            <td>@Historial_Ventas.CantidadVendida</td>
                                            <td>@Historial_Ventas.IdMedicamento</td>
                                            <td>@Historial_Ventas.PrecioUnitario</td>
                                            <td>@Historial_Ventas.Total</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center">
                            <p class="text-muted">No se encontraron ventas.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>